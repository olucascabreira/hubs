# ---------------------------------------------------------------------------
# HUB WuzAPI <-> Chatwoot
# ---------------------------------------------------------------------------

# Porta e bind do servico HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# URL publica do HUB. E ela que sera gravada como webhook no WuzAPI e no
# inbox API do Chatwoot durante o provisionamento. PRECISA ser alcancavel
# pelos dois sistemas (use https em producao / ngrok em dev).
PUBLIC_URL=https://hub.seudominio.com.br

# Token exigido no header X-Admin-Token das rotas /admin/*
ADMIN_TOKEN=troque-este-token-por-um-valor-aleatorio-longo

# Postgres
DATABASE_URL=postgres://hub:hub@postgres:5432/hub
DATABASE_SSL=false

# Redis (filas BullMQ + deduplicacao)
REDIS_URL=redis://redis:6379

# Workers
INBOUND_CONCURRENCY=8
OUTBOUND_CONCURRENCY=8
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=3000

# Limites de midia
MAX_MEDIA_BYTES=41943040

# Header usado pelo WuzAPI para assinar o webhook (HMAC SHA-256).
# O HUB tambem aceita X-Hub-Signature-256 / X-Signature-256 automaticamente.
WUZAPI_SIGNATURE_HEADER=X-Webhook-Signature

# Diagnostico: grava o corpo cru de cada webhook em CAPTURE_DIR.
# Os arquivos contem conteudo de conversas — ligue so durante a homologacao.
CAPTURE_RAW_WEBHOOKS=false
CAPTURE_DIR=./captures
CAPTURE_MAX_FILES=200

# ---------------------------------------------------------------------------
# Defaults aplicados a novos tenants (podem ser sobrescritos por tenant)
# ---------------------------------------------------------------------------
DEFAULT_WUZAPI_BASE_URL=http://wuzapi:8080
DEFAULT_CHATWOOT_BASE_URL=https://app.chatwoot.com

# Eventos assinados no WuzAPI durante o provisionamento
DEFAULT_WUZAPI_EVENTS=Message,ReadReceipt

# Prefixo do identifier do contato no Chatwoot: <prefixo><jid>
CONTACT_IDENTIFIER_PREFIX=wa:

# Prefixo das chaves no Redis. Isola o HUB quando a instancia e compartilhada
# com outras aplicacoes que tambem usam BullMQ.
REDIS_PREFIX=hub

# Sufixo no nome do contato de grupo, para distingui-lo de uma pessoa na
# lista de conversas. Vazio = nao acrescenta nada.
GROUP_NAME_SUFFIX= (Grupo)
