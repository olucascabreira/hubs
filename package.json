{
  "name": "wuzapi-chatwoot-hub",
  "version": "1.0.0",
  "private": true,
  "description": "HUB de integracao multi-tenant entre WuzAPI (WhatsApp) e Chatwoot",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/scripts/smoke.ts && tsx src/scripts/smoke-http.ts"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
